# Copy to `.env.local` — Expo loads it automatically and `EXPO_PUBLIC_*` vars
# are inlined into the JS bundle at build time.
#
# Anything NOT prefixed with EXPO_PUBLIC_ is unavailable to the app at runtime.
# Never put a secret (API key, service token) in this file: everything that
# reaches the bundle is readable by anyone who downloads the app.

# Base URL of the FoodFen backend.
# Android emulator reaches the host machine at 10.0.2.2, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional: request timeout in milliseconds (defaults to 15000).
EXPO_PUBLIC_API_TIMEOUT_MS=15000
